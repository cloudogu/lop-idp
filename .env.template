# Local development of lop-idp sub-components.
# Used by `make dev-component-apply` / `make dev-component-helm-apply`.
# Uncomment and adjust ONLY the components you are currently developing: a component
# is built and swapped for its local version exactly when its DEV_DIR_<name> is set.
# Component names with dashes use underscores (e.g. ldap-mapper -> DEV_DIR_ldap_mapper).
#DEV_DIR_ldap=../ecosystem/containers/ldap
#DEV_DIR_cas=../ecosystem/containers/cas
#DEV_DIR_usermgt=../ecosystem/containers/usermgt
#DEV_DIR_ldap_mapper=../ecosystem/containers/ldap-mapper
#DEV_DIR_k8s_auth_registration_operator=../k8s-auth-registration-operator